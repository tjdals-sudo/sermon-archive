---
import Base from '../../layouts/Base.astro';
import { sermons, formatDate } from '../../lib/sermons.mjs';

export function getStaticPaths() {
  return sermons.map((s, i) => ({
    params: { slug: s.slug },
    props: { s, newer: sermons[i - 1] ?? null, older: sermons[i + 1] ?? null },
  }));
}

const { s, newer, older } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = formatDate(s.date);
const asset = (p) => (p ? base + p : null);
const slides = (s.files?.slides ?? []).map(asset);
const pdf = asset(s.files?.pdf);
const canView = s.pptAccess !== 'private' && slides.length > 0;
const canDownload = s.pptAccess === 'download' && pdf;
---
<Base
  title={s.title}
  description={s.summary || `${s.scriptureRef} · ${s.preacher}`}
  ogImage={s.files?.thumb}
  ogType="article"
>
  <a class="back" href={base + '/'}>← 설교 목록</a>

  <header class="sermon-head">
    <div class="sermon-date">{d.full}</div>
    <h1>{s.title}</h1>
    {s.scriptureRef && (
      s.scriptureUrl
        ? <a class="scripture" href={s.scriptureUrl} target="_blank" rel="noopener">📖 {s.scriptureRef} 보기 ↗</a>
        : <span class="scripture">📖 {s.scriptureRef}</span>
    )}
    {s.preacher && <div class="preacher">{s.preacher}</div>}
  </header>

  {s.summary && (
    <section class="block">
      <h2>한눈에 보기</h2>
      <p class="summary">{s.summary}</p>
    </section>
  )}

  {s.keyPoints?.length > 0 && (
    <section class="block">
      <h2>핵심 포인트</h2>
      <ul class="points">{s.keyPoints.map((p) => <li>{p}</li>)}</ul>
    </section>
  )}

  {canView && (
    <section class="block">
      <h2>설교 자료 <span class="count">{slides.length}장</span></h2>
      <div class="slides">
        {slides.map((src, i) => (
          <figure class="slide">
            <img src={src} alt={`${i + 1}번째 장`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" width="1200" />
            <figcaption>{i + 1} / {slides.length}</figcaption>
          </figure>
        ))}
      </div>
      {canDownload && (
        <div class="btn-row"><a class="btn" href={pdf} download>PDF로 내려받기</a></div>
      )}
      {!canDownload && <p class="note">저작권 보호를 위해 화면 보기만 제공합니다.</p>}
    </section>
  )}

  <nav class="nearby">
    {older && (
      <a class="nearby-item" href={`${base}/sermons/${older.slug}/`}>
        <span>← 이전 설교</span><b>{older.title}</b>
      </a>
    )}
    {newer && (
      <a class="nearby-item next" href={`${base}/sermons/${newer.slug}/`}>
        <span>다음 설교 →</span><b>{newer.title}</b>
      </a>
    )}
  </nav>

  <section class="block">
    <p class="note">
      설교 원고 전문은 공개하지 않습니다. 성경 본문 역시 저작권 관계로 싣지 않으니,
      위 본문 구절 버튼을 눌러 성경 사이트에서 읽어 주세요.
    </p>
  </section>

  <button id="toTop" class="to-top" aria-label="맨 위로" hidden>↑</button>
  <script is:inline>
    const btn = document.getElementById('toTop');
    const onScroll = () => { btn.hidden = scrollY < 700; };
    addEventListener('scroll', onScroll, { passive: true });
    btn.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
    onScroll();
  </script>
</Base>

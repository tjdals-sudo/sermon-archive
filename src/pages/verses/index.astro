---
import Base from '../../layouts/Base.astro';
import months from '../../data-months.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rows = Object.entries(months)
  .sort((a, b) => b[0].localeCompare(a[0]))
  .map(([key, v]) => ({ key, month: Number(key.slice(5, 7)), ...v }))
  .filter((r) => r.verse?.ref);

// 이번 달 것을 맨 위에 펼쳐 둡니다
const thisMonth = new Date().toISOString().slice(0, 7);
---
<Base
  title="말씀 띠부씰"
  description="소년부가 달마다 함께 외우는 말씀 띠부씰입니다."
  ogImage={rows[0]?.verse?.image}
>
  <a class="back-btn" href={base + '/'}>← 홈으로 돌아가기</a>
  <h1 class="page-title">말씀 띠부씰</h1>

  {rows.map((r) => (
    <section class="verse-block" id={`m${r.month}`}>
      <div class="month-head">
        <span class="month-num">{r.month}월</span>
        {r.theme && <b class="month-theme">{r.theme}</b>}
        {r.key === thisMonth && <span class="badge-now">이번 달</span>}
      </div>

      {r.verse.image && (
        <figure class="verse-card">
          <img src={base + r.verse.image} alt={`${r.month}월 말씀 띠부씰 — ${r.verse.text}`}
               loading="lazy" decoding="async" />
        </figure>
      )}

      <p class="verse-text">{r.verse.text}</p>

      {r.verse.url
        ? <a class="scripture" href={r.verse.url} target="_blank" rel="noopener">📖 {r.verse.ref} 보기 ↗</a>
        : <span class="scripture">📖 {r.verse.ref}</span>}
    </section>
  ))}

  <a class="back-btn wide home" href={base + '/'}>🏠 홈으로 돌아가기</a>
</Base>

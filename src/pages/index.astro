---
import Base from '../layouts/Base.astro';
import { sermons, formatDate } from '../lib/sermons.mjs';
import { site } from '../../site.config.mjs';
import months from '../data-months.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const latest = sermons[0];
const d = latest ? formatDate(latest.date) : null;

// 말씀 띠부씰이 있는 달 (오래된 순 — 화면에서는 JS가 이번 달 것을 고릅니다)
const stickers = Object.entries(months)
  .filter(([, v]) => v.verse?.image)
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([key, v]) => ({ key, month: Number(key.slice(5, 7)), ...v.verse }));

// 이번 주 말씀 한 줄: 최근 설교 핵심포인트의 마지막 문장
const oneLine = latest?.keyPoints?.at(-1);

// 올해 설교 달력: 1~12월의 모든 주일을 점으로, 설교가 있는 주일은 채운 점
const byDate = new Map();
for (const s of sermons) if (!byDate.has(s.date)) byDate.set(s.date, s);
const yearCount = sermons.filter((s) => s.date.startsWith(site.year)).length;
const pad = (n) => String(n).padStart(2, '0');
const calendar = Array.from({ length: 12 }, (_, i) => {
  const sundays = [];
  const day = new Date(Number(site.year), i, 1);
  day.setDate(1 + ((7 - day.getDay()) % 7));      // 그 달의 첫 주일
  while (day.getMonth() === i) {
    const iso = `${site.year}-${pad(i + 1)}-${pad(day.getDate())}`;
    sundays.push({ iso, d: day.getDate(), sermon: byDate.get(iso) });
    day.setDate(day.getDate() + 7);
  }
  return { month: i + 1, sundays };
});
---
<Base>
  <section class="hero">
    <p class="hero-sub">{site.churchName}</p>
    <h1 class="hero-title">{site.year}년<br />설교 아카이브</h1>
    <p class="hero-note">지난 주일 말씀을 언제든 다시 볼 수 있습니다.</p>
  </section>

  {stickers.length > 0 && (
    <section class="sticker-now" id="stickerNow" hidden>
      {stickers.map((s) => (
        <a class="sticker-card" href={`${base}/verses/#m${s.month}`} data-key={s.key} hidden>
          <img data-src={base + s.image} alt={`${s.month}월 말씀 띠부씰`} decoding="async" />
          <span class="sticker-text">
            <small>이번 달 말씀 띠부씰</small>
            <b>{s.month}월 · {s.ref}</b>
          </span>
          <span class="menu-go" aria-hidden="true">›</span>
        </a>
      ))}
    </section>
  )}

  <nav class="menu">
    <a class="menu-item" href={base + '/sermons/'}>
      <span class="menu-icon" aria-hidden="true">📖</span>
      <span class="menu-text">
        <b>지난 설교 보기</b>
        <small>{sermons.length}편 · 날짜·주제별로 찾기</small>
      </span>
      <span class="menu-go" aria-hidden="true">›</span>
    </a>
    <a class="menu-item" href={base + '/verses/'}>
      <span class="menu-icon" aria-hidden="true">✍️</span>
      <span class="menu-text">
        <b>말씀 띠부씰</b>
        <small>달마다 함께 외우는 말씀</small>
      </span>
      <span class="menu-go" aria-hidden="true">›</span>
    </a>
    <a class="menu-item" href={base + '/themes/'}>
      <span class="menu-icon" aria-hidden="true">🗓️</span>
      <span class="menu-text">
        <b>월별 설교 주제</b>
        <small>한 달에 하나씩</small>
      </span>
      <span class="menu-go" aria-hidden="true">›</span>
    </a>
  </nav>

  {latest && (
    <section class="latest">
      <h2 class="latest-label">가장 최근 설교</h2>
      <a class="card" href={`${base}/sermons/${latest.slug}/`}>
        <div class="card-body">
          <div class="card-date">{d.full}</div>
          <h3 class="card-title">{latest.title}</h3>
          <div class="card-meta">{latest.scriptureRef}</div>
        </div>
        {latest.files?.thumb && (
          <img class="card-thumb" src={base + latest.files.thumb} alt="" loading="lazy" />
        )}
      </a>
      {oneLine && (
        <a class="one-line" href={`${base}/sermons/${latest.slug}/`}>
          <small>이번 주 말씀 한 줄</small>
          <blockquote>{oneLine}</blockquote>
        </a>
      )}
    </section>
  )}

  <section class="year-cal">
    <h2 class="latest-label">올해 설교 달력 <span class="year-count">{site.year}년 {yearCount}편</span></h2>
    <div class="cal-box">
      {calendar.map((m) => (
        <div class="cal-row">
          <span class="cal-month">{m.month}월</span>
          <span class="cal-dots">
            {m.sundays.map((w) =>
              w.sermon ? (
                <a class="cal-dot on" href={`${base}/sermons/${w.sermon.slug}/`} data-d={w.iso}
                   title={w.sermon.title} aria-label={`${m.month}월 ${w.d}일 ${w.sermon.title}`}>{w.d}</a>
              ) : (
                <span class="cal-dot" data-d={w.iso} aria-hidden="true">{w.d}</span>
              )
            )}
          </span>
        </div>
      ))}
    </div>
    <p class="cal-legend"><span class="cal-dot on" aria-hidden="true"></span> 설교 있음 · 숫자는 주일 날짜</p>
  </section>
</Base>

<script is:inline>
  // 오늘 날짜에 맞는 말씀 띠부씰을 고릅니다.
  // 사이트를 다시 만들지 않아도 달이 바뀌면 알아서 바뀝니다.
  (() => {
    const box = document.getElementById('stickerNow');
    if (!box) return;
    const cards = [...box.querySelectorAll('.sticker-card')];
    if (!cards.length) return;

    const now = new Date();
    const key = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;

    // 이번 달 것이 있으면 그것, 없으면 지나간 달 중 가장 최근 것
    let pick = cards.find((c) => c.dataset.key === key);
    if (!pick) {
      const past = cards.filter((c) => c.dataset.key <= key);
      pick = past.length ? past[past.length - 1] : cards[cards.length - 1];
    }
    const img = pick.querySelector('img');
    img.src = img.dataset.src;          // 고른 것만 이미지를 불러옵니다
    pick.hidden = false;
    box.hidden = false;
  })();

  // 설교 달력: 아직 오지 않은 주일은 흐리게
  (() => {
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    document.querySelectorAll('.cal-dot[data-d]').forEach((el) => {
      if (el.dataset.d > today) el.classList.add('future');
      if (el.dataset.d === today) el.classList.add('today');
    });
  })();
</script>
